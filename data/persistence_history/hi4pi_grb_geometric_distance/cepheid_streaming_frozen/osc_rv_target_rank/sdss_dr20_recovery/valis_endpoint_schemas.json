      "security": [
        {
          "SDSSAuthPasswordBearer": []
        }
      ],
      "parameters": [
        {
          "name": "sdss_id",
          "in": "query",
          "required": true,
          "schema": {
            "type": "integer",
            "description": "Value of sdss_id",
            "title": "Sdss Id"
          },
          "description": "Value of sdss_id",
          "example": 47510284
        },
        {
          "name": "release",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
