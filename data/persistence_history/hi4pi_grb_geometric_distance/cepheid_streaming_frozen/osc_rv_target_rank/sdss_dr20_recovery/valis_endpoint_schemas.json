{
  "/target/spectra/{sdss_id}": {
    "get": {
      "tags": [
        "target"
      ],
      "summary": "Retrieve a spectrum for a target sdss_id",
      "operationId": "Target_get_spectrum_target_spectra__sdss_id__get",
      "security": [
        {
          "SDSSAuthPasswordBearer": []
        }
      ],
      "parameters": [
        {
          "name": "sdss_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "title": "The sdss_id of the target to get"
          },
          "example": 23326
        },
        {
          "name": "product",
          "in": "query",
          "required": true,
          "schema": {
            "type": "string",
            "description": "The file species or data product name",
            "title": "Product"
          },
          "description": "The file species or data product name",
          "example": "specLite"
        },
        {
          "name": "ext",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "description": "For multi-extension spectra, e.g. mwmStar, the name of the spectral extension",
            "title": "Ext"
          },
          "description": "For multi-extension spectra, e.g. mwmStar, the name of the spectral extension",
          "example": "BOSS/APO"
        },
        {
          "name": "release",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "description": "The SDSS data release",
            "title": "Release"
          },
          "description": "The SDSS data release",
          "example": "DR20"
        }
      ],
      "responses": {
        "200": {
          "description": "Successful Response",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SpectrumModel"
                },
                "title": "Response Target Get Spectrum Target Spectra  Sdss Id  Get"
              }
            }
          }
        },
        "422": {
          "description": "Validation Error",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HTTPValidationError"
              }
            }
          }
        }
      }
    }
  },
